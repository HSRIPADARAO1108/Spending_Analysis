"""Scheduled jobs.
  python notifier.py daily              -> 10 PM Telegram check-in (phone notification)
  python notifier.py monthly [YYYY-MM]  -> monthly analysis email (default: last month)
"""
import os
import smtplib
import sys
from datetime import datetime
from email.mime.multipart import MIMEMultipart
from email.mime.text import MIMEText
from zoneinfo import ZoneInfo

import pandas as pd
import requests

from db import load

IST = ZoneInfo("Asia/Kolkata")
MEMBERS = ["Sripada", "My Brother"]
HEAD = {"Sripada": "linear-gradient(120deg,#6c5ce7,#f06595)", "My Brother": "linear-gradient(120deg,#ff922b,#fcc419)"}
COLOR = {"Food": "#ff8a3d", "Travel": "#4dabf7", "Shopping": "#f06595", "Bills": "#f5b800",
         "Rent": "#20c997", "Fun": "#9775fa", "Other": "#ff5d73"}
ICON = {"Food": "🍔", "Travel": "🚌", "Shopping": "🛍️", "Bills": "💡", "Rent": "🏠", "Fun": "🎮", "Other": "✨"}


def inr(x):
    return f"₹{x:,.0f}"


def totals(df):
    return (df.loc[df.type == "earn", "amount"].sum(), df.loc[df.type == "spend", "amount"].sum())


# ---------- 10 PM phone notification (Telegram) ----------
def tg_send(text):
    token = os.environ["TELEGRAM_BOT_TOKEN"]
    for chat in os.environ["TELEGRAM_CHAT_IDS"].split(","):
        r = requests.post(f"https://api.telegram.org/bot{token}/sendMessage",
                          json={"chat_id": chat.strip(), "text": text}, timeout=20)
        r.raise_for_status()


def daily():
    today = datetime.now(IST).date()
    lines, missing = ["🔔 10 PM check-in"], []
    for m in MEMBERS:
        d = load(m)
        d = d[d.date.dt.date == today]
        e, s = totals(d)
        if d[d.type == "spend"].empty:
            missing.append(m)
        lines.append(f"\n{m}\n💰 Earned {inr(e)}   🛍️ Spent {inr(s)}   🎉 Left {inr(e - s)}")
    lines.append("\n⚠️ No spending added today for: " + ", ".join(missing) + ". Please update!"
                 if missing else "\n✅ Everything is updated. Great job!")
    if os.getenv("APP_URL"):
        lines.append(f"\nOpen the app: {os.environ['APP_URL']}")
    tg_send("\n".join(lines))


# ---------- Monthly email ----------
def member_block(m, period):
    df = load(m)
    cur = df[df.date.dt.to_period("M") == period]
    prev = df[df.date.dt.to_period("M") == period - 1]
    e, s = totals(cur)
    _, ps = totals(prev)
    cats = cur[cur.type == "spend"].groupby("category").amount.sum().sort_values(ascending=False)
    change = "" if ps == 0 else f" ({'↑' if s > ps else '↓'} {abs(s - ps) / ps * 100:.0f}% vs last month)"
    rows = "".join(
        f'<tr><td style="padding:4px 0">{ICON.get(c, "")} {c}</td>'
        f'<td style="width:45%"><div style="background:#eee;border-radius:9px"><div style="height:12px;border-radius:9px;'
        f'width:{v / cats.iloc[0] * 100:.0f}%;background:{COLOR.get(c, "#888")}"></div></div></td>'
        f'<td style="text-align:right;font-weight:700">{inr(v)}</td></tr>' for c, v in cats.items()
    ) or '<tr><td style="color:#888">No spending recorded</td></tr>'
    left = e - s
    html = f"""
<div style="border-radius:18px;overflow:hidden;box-shadow:0 4px 12px rgba(0,0,0,.12);margin:16px 0;background:#fff">
 <div style="background:{HEAD[m]};color:#fff;padding:14px 18px;font-size:20px;font-weight:800">{m}</div>
 <div style="padding:16px 18px">
  <table style="width:100%;text-align:center"><tr>
   <td style="background:#d3f9d8;border-radius:12px;padding:10px"><div style="color:#0a8f6b">💰 Earned</div><b style="font-size:20px;color:#0a8f6b">{inr(e)}</b></td>
   <td style="width:8px"></td>
   <td style="background:#ffe3e3;border-radius:12px;padding:10px"><div style="color:#e0364f">🛍️ Spent</div><b style="font-size:20px;color:#e0364f">{inr(s)}</b></td>
   <td style="width:8px"></td>
   <td style="background:#e5dbff;border-radius:12px;padding:10px"><div style="color:#5f3dc4">🎉 Left</div><b style="font-size:20px;color:#5f3dc4">{inr(left)}</b></td>
  </tr></table>
  <p style="color:#555">Spending{change}</p>
  <table style="width:100%">{rows}</table>
 </div></div>"""
    text = f"{m}: earned {inr(e)}, spent {inr(s)}, left {inr(left)}{change}"
    return html, text, e, s


def build_email(period):
    label = period.strftime("%B %Y")
    blocks, texts, E, S = [], [], 0, 0
    for m in MEMBERS:
        h, t, e, s = member_block(m, period)
        blocks.append(h); texts.append(t); E += e; S += s
    body = f"""
<div style="font-family:Arial,sans-serif;max-width:620px;margin:auto;background:#fff7ec;padding:16px">
 <div style="background:linear-gradient(120deg,#6c5ce7,#f06595,#ff922b);color:#fff;border-radius:18px;padding:20px">
  <div style="font-size:24px;font-weight:800">💰 Family money report</div><div>{label}</div>
  <div style="margin-top:8px;font-size:16px">Together: earned {inr(E)} · spent {inr(S)} · left {inr(E - S)}</div>
 </div>{''.join(blocks)}
 <p style="color:#888;font-size:12px;text-align:center">Sent automatically by your Family Money Tracker</p></div>"""
    return f"Family money report · {label}", body, "\n".join(texts)


def monthly():
    period = pd.Period(sys.argv[2], "M") if len(sys.argv) > 2 else pd.Period(datetime.now(IST).date(), "M") - 1
    subject, html, text = build_email(period)
    msg = MIMEMultipart("alternative")
    msg["Subject"], msg["From"], msg["To"] = subject, os.environ["SMTP_USER"], os.environ["EMAIL_TO"]
    msg.attach(MIMEText(text, "plain", "utf-8"))
    msg.attach(MIMEText(html, "html", "utf-8"))
    with smtplib.SMTP_SSL(os.getenv("SMTP_HOST", "smtp.gmail.com"), int(os.getenv("SMTP_PORT", "465"))) as s:
        s.login(os.environ["SMTP_USER"], os.environ["SMTP_PASS"])
        s.sendmail(msg["From"], [x.strip() for x in os.environ["EMAIL_TO"].split(",")], msg.as_string())


if __name__ == "__main__":
    job = sys.argv[1] if len(sys.argv) > 1 else ""
    {"daily": daily, "monthly": monthly}[job]()
